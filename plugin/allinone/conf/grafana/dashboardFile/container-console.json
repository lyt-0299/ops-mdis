{
  "uid": "ContainerCons",
  "title": "Container Console",
  "tags": [
    "logs",
    "containers"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1d",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m",
      "15m",
      "30m",
      "1h"
    ],
    "quick_ranges": [
      {
        "display": "Last 15 minutes",
        "from": "now-15m",
        "to": "now"
      },
      {
        "display": "Last 1 hour",
        "from": "now-1h",
        "to": "now"
      },
      {
        "display": "Last 3 hours",
        "from": "now-3h",
        "to": "now"
      },
      {
        "display": "Last 6 hours",
        "from": "now-6h",
        "to": "now"
      },
      {
        "display": "Last 12 hours",
        "from": "now-12h",
        "to": "now"
      },
      {
        "display": "Last 24 hours",
        "from": "now-24h",
        "to": "now"
      },
      {
        "display": "Last 2 days",
        "from": "now-2d",
        "to": "now"
      },
      {
        "display": "Last 7 days",
        "from": "now-7d",
        "to": "now"
      },
      {
        "display": "Last 30 days",
        "from": "now-30d",
        "to": "now"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "search",
        "type": "textbox",
        "label": "Search Keyword",
        "description": "Full-text match on log body + all stream labels (case-insensitive)",
        "current": {
          "text": "",
          "value": ""
        },
        "options": [
          {
            "text": "",
            "value": "",
            "selected": true
          }
        ],
        "query": "",
        "hide": 0,
        "skipUrlSync": false
      },
      {
        "name": "container",
        "type": "query",
        "label": "Container",
        "datasource": {
          "type": "loki",
          "uid": "DS_LOKI"
        },
        "query": "label_values({log_source=~\"docker|k8s\"}, container)",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "refresh": 2,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Container Log Rate (lines/s)",
      "datasource": {
        "type": "loki",
        "uid": "DS_LOKI"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "DS_LOKI"
          },
          "refId": "A",
          "expr": "sum(rate({log_source=~\"docker|k8s\", container=~\"$container\"} |~ \"(?i)${search:raw}\" [1m])) by (namespace, container)",
          "legendFormat": "{{namespace}}/{{container}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 2,
      "type": "logs",
      "title": "Container Raw Logs",
      "datasource": {
        "type": "loki",
        "uid": "DS_LOKI"
      },
      "gridPos": {
        "h": 18,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "DS_LOKI"
          },
          "refId": "A",
          "expr": "{log_source=~\"docker|k8s\", container=~\"$container\"} |~ \"(?i)${search:raw}\"",
          "maxLines": 300
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending",
        "enableInfiniteScrolling": true,
        "showControls": true
      }
    }
  ]
}
