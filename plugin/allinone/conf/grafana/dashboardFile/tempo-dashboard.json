{
  "__inputs": [
    {
      "name": "DS_TEMPO",
      "label": "DS_TEMPO",
      "type": "datasource",
      "pluginId": "tempo"
    },
    {
      "name": "DS_PROMETHEUS",
      "label": "DS_PROMETHEUS",
      "type": "datasource",
      "pluginId": "prometheus"
    }
  ],
  "uid": "TempoDashbrd",
  "title": "Tempo Dashboard",
  "tags": [],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m",
      "15m",
      "30m",
      "1h"
    ],
    "quick_ranges": [
      {
        "display": "Last 15 minutes",
        "from": "now-15m",
        "to": "now"
      },
      {
        "display": "Last 1 hour",
        "from": "now-1h",
        "to": "now"
      },
      {
        "display": "Last 3 hours",
        "from": "now-3h",
        "to": "now"
      },
      {
        "display": "Last 6 hours",
        "from": "now-6h",
        "to": "now"
      },
      {
        "display": "Last 12 hours",
        "from": "now-12h",
        "to": "now"
      },
      {
        "display": "Last 24 hours",
        "from": "now-24h",
        "to": "now"
      },
      {
        "display": "Last 2 days",
        "from": "now-2d",
        "to": "now"
      },
      {
        "display": "Last 7 days",
        "from": "now-7d",
        "to": "now"
      },
      {
        "display": "Last 30 days",
        "from": "now-30d",
        "to": "now"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "label": "Service",
        "datasource": {
          "type": "prometheus",
          "uid": "DS_PROMETHEUS"
        },
        "query": {
          "qryType": 1,
          "query": "label_values(traces_spanmetrics_calls_total, service)",
          "refId": "StandardVariableQuery"
        },
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "op",
        "type": "textbox",
        "label": "Operation Keyword",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      },
      {
        "name": "minDur",
        "type": "textbox",
        "label": "Min Duration (ms)",
        "query": "0",
        "current": {
          "text": "0",
          "value": "0"
        }
      },
      {
        "name": "statusFilter",
        "type": "custom",
        "label": "Error Filter",
        "query": "",
        "current": {
          "text": "All",
          "value": "&& duration >= 0ns",
          "selected": true
        },
        "options": [
          {
            "text": "All",
            "value": "&& duration >= 0ns",
            "selected": true
          },
          {
            "text": "4xx/5xx Errors",
            "value": "&& span.http.status_code =~ \"[45]..\"",
            "selected": false
          },
          {
            "text": "5xx Errors Only",
            "value": "&& span.http.status_code =~ \"5..\"",
            "selected": false
          }
        ]
      },
      {
        "name": "traceId",
        "type": "textbox",
        "label": "Trace ID — opens waterfall below (direct view, not a filter)",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "id": 2,
      "type": "timeseries",
      "title": "Request Rate req/s (by Service)",
      "datasource": {
        "type": "prometheus",
        "uid": "DS_PROMETHEUS"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "DS_PROMETHEUS"
          },
          "refId": "A",
          "expr": "sum by(service) (rate(traces_spanmetrics_calls_total[5m]))",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Error Rate 5xx/s (by Service, server-side errors)",
      "datasource": {
        "type": "prometheus",
        "uid": "DS_PROMETHEUS"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "DS_PROMETHEUS"
          },
          "refId": "A",
          "expr": "sum by(service) (rate(traces_spanmetrics_calls_total{http_status_code=~\"5..\"}[5m]))",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          },
          "unit": "reqps",
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          },
          "noValue": "0 (no errors)"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "P95 Latency (by Service)",
      "datasource": {
        "type": "prometheus",
        "uid": "DS_PROMETHEUS"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "DS_PROMETHEUS"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by(service, le) (rate(traces_spanmetrics_latency_bucket[5m])))",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Recent Traces  (search by Service/Operation/Duration/Error at the top; click a Trace ID → waterfall below)",
      "datasource": {
        "type": "tempo",
        "uid": "DS_TEMPO"
      },
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "DS_TEMPO"
          },
          "refId": "A",
          "queryType": "traceql",
          "query": "{ resource.service.name =~ \"${service}\" && name =~ \"(?i).*${op}.*\" && duration >= ${minDur}ms ${statusFilter:raw} } | select(resource.service.name, name)",
          "limit": 50,
          "tableType": "spans"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Trace Service": true,
              "Trace Name": true,
              "Span ID": true
            },
            "renameByName": {
              "traceIdHidden": "Trace ID",
              "service.name": "Service",
              "Name": "Operation"
            },
            "indexByName": {
              "traceIdHidden": 0,
              "service.name": 1,
              "Name": 2,
              "Start time": 3,
              "Duration": 4
            }
          }
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "traceIdHidden"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 290
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "View Trace Waterfall",
                    "url": "/d/TempoDashbrd/tempo-dashboard?var-traceId=${__value.raw}&orgId=1&kiosk&${__url_time_range}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "service.name"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Start time"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 165
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Duration"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          }
        ]
      }
    },
    {
      "id": 7,
      "type": "traces",
      "title": "Trace Waterfall · click a Trace ID in the table above (or paste an ID at the top) to expand the full trace here",
      "datasource": {
        "type": "tempo",
        "uid": "DS_TEMPO"
      },
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "DS_TEMPO"
          },
          "refId": "A",
          "queryType": "traceql",
          "query": "${traceId}"
        }
      ],
      "options": {}
    },
    {
      "id": 6,
      "type": "table",
      "title": "Top Service Calls (most frequent service-to-service traces)",
      "datasource": {
        "type": "prometheus",
        "uid": "DS_PROMETHEUS"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "DS_PROMETHEUS"
          },
          "refId": "A",
          "expr": "topk(20, sum by(client, server) (rate(traces_service_graph_request_total[5m])))",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__metrics_gen_instance": true,
              "cluster": true,
              "source": true,
              "job": true,
              "instance": true
            },
            "renameByName": {
              "client": "Caller",
              "server": "Callee",
              "Value": "Call Rate/s"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Call Rate/s",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Call Rate/s"
            },
            "properties": [
              {
                "id": "unit",
                "value": "reqps"
              },
              {
                "id": "decimals",
                "value": 3
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "continuous-BlPu"
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
