# 敏感配置：登录 token、告警凭据加密密钥、被监控中间件的密码。
# 拷贝为 10-secret.yaml 后按实际填写；10-secret.yaml 已在 .gitignore，不入库。
#
# ENV_ALERT_CRYPTO_KEY 必须是 32 字节：openssl rand -hex 16
#
# 注意：中间件凭据也可以完全不写在这里——1.4.0 的数据源注册中心支持从 UI 配置
# 并加密存进 ops-mongo。这里的 env 只是「首启播种」用，UI 配好后以 UI 为准。
# 最小可用只需要 ENV_OPS_TOKEN + ENV_ALERT_CRYPTO_KEY 两项。
apiVersion: v1
kind: Secret
metadata:
  name: ops-secret
  namespace: hap-ops
type: Opaque
stringData:
  # ── 必填 ──────────────────────────────────────────────
  ENV_OPS_TOKEN: "change-me-login-token"
  ENV_ALERT_CRYPTO_KEY: "change-me-32-byte-hex-secret----"   # openssl rand -hex 16

  # ⚠️ 被监控中间件的凭据不在这里。数据源（含密码）全部在 UI「数据源」页维护，
  # 密码用 ENV_ALERT_CRYPTO_KEY 加密后存进 ops-mongo，不落 Secret。
  # 慢查询诊断目标 = 数据源页里勾了「诊断」用途的 MongoDB 实例。

  # ── 对象存储（可选）：日志(Loki) / 链路(Tempo) 落 S3 兼容存储 ──────────
  # 不配则用各 StatefulSet 的本地卷。桶名不在这里，在 30-stateful.yaml 里各自的
  # ENV_S3_BUCKET_LOKI / ENV_S3_BUCKET_TEMPO。⚠️ 两者必须用不同的桶，且部署前
  # 要在对象存储里先建好——桶不存在时 Loki 报 NoSuchBucket 直接 CrashLoop。
  # endpoint 要填集群 Pod 能解析到的地址：自建 MinIO 在集群内就用
  # <svc>.<ns>.svc.cluster.local:9000，在集群外则填其可达的 IP:端口。
  # path style：MinIO / UCloud US3 填 "true"；腾讯云 COS、阿里云 OSS 只支持
  # virtual-hosted，必须填 "false"。
  # ENV_S3_ENDPOINT: "minio.default.svc.cluster.local:9000"
  # ENV_S3_ACCESS_KEY: ""
  # ENV_S3_SECRET_KEY: ""
  # ENV_S3_FORCE_PATH_STYLE: "true"
